# Configurações do Google Analytics 4
# Obtenha o ID no painel do GA4 (ex: G-XXXXXXXXXX)
VITE_GA4_ID=G-XXXXXXXXXX

# Configurações do Mapa e API Forge
# URL base para chamadas de API (opcional, padrão em Map.tsx)
VITE_FRONTEND_FORGE_API_URL=https://api.dagaz.dev
# Chave de API para serviços de mapa/forja
VITE_FRONTEND_FORGE_API_KEY=sua_chave_aqui

# Configurações de Autenticação/Portal
# URL do portal de autenticação OAuth
VITE_OAUTH_PORTAL_URL=https://auth.dagaz.dev
# ID da aplicação cadastrada no portal
VITE_APP_ID=seu_app_id_aqui

# Notas:
# 1. Copie este arquivo para um novo arquivo chamado .env
# 2. Substitua os valores acima pelos valores reais do seu ambiente.
# 3. O arquivo .env NÃO deve ser enviado para o repositório Git por segurança.
